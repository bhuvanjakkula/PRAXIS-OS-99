include Setup-PRAXIS.cmd Start-PRAXIS.cmd Makefile
include Setup-PostgreSQL.ps1 Start-PRAXIS-PostgreSQL.cmd
recursive-include docs *.md
recursive-include docs/source_material *.txt
recursive-include docs/source_material/policy-starter-v0.1.0 *
recursive-include apps *.py
recursive-include tests *.py
recursive-include tests/browser *.mjs *.cjs
include tests/browser/package.json tests/browser/package-lock.json
recursive-include tools *.py
recursive-include .github/workflows *.yml
recursive-include src/praxis/web *.html *.css *.js *.json
recursive-include examples *.json
recursive-include examples *.txt
recursive-include migrations *.sql
include Dockerfile.api Dockerfile.worker compose.yaml compose.beta.yaml Caddyfile.beta .env.example
include render.yaml
prune tests/browser/node_modules
prune tests/browser/test-results
prune tests/browser/playwright-report
