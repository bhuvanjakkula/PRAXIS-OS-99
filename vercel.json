{
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/index.py?__path=/v1/$1"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index.py?__path=/v1/$1"
    },
    {
      "source": "/v2/(.*)",
      "destination": "/api/index.py?__path=/v2/$1"
    },
    {
      "source": "/api/v2/(.*)",
      "destination": "/api/index.py?__path=/v2/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path=/health"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path=/openapi.json"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}