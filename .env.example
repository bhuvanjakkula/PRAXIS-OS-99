# Copy to .env locally; never commit populated credentials.
POSTGRES_PASSWORD=
# URL-encode the password when constructing this URL.
PRAXIS_DATABASE_URL=postgresql+psycopg://praxis:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/praxis
PRAXIS_SIGNING_KEY=
# Optional OpenTelemetry collector, configure only for an authorized destination.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Connector secrets are looked up only by registered env: references.
# General web search is optional; keep its API key on the server only.
PRAXIS_CONNECTOR_EXAMPLE=

PRAXIS_BRAVE_API_KEY=

# Set a domain you control for the restricted beta HTTPS ingress.
PRAXIS_BETA_DOMAIN=

# Optional server-only AI adapter. Disabled until explicitly configured.
PRAXIS_AI_PROVIDER=none
OPENAI_API_KEY=
PRAXIS_OPENAI_MODEL=gpt-4.1-mini-2025-04-14
PRAXIS_OPENAI_TIMEOUT=30
PRAXIS_OPENAI_MAX_OUTPUT_TOKENS=2500
PRAXIS_AI_ALLOWED_CLASSIFICATIONS=public
# Extra custom domains; the hosted launcher also adds Render's assigned hostname.
PRAXIS_ALLOWED_HOSTS=
