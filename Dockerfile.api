FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md requirements-production.txt ./
COPY src ./src
RUN pip install --no-cache-dir -r requirements-production.txt && pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home praxis
USER praxis
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "praxis.product.api:application", "--factory", "--host", "0.0.0.0", "--port", "8000"]
